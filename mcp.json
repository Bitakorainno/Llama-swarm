{
  "mcpServers": {
    "agents": {
      "command": "cmd",
      "args": ["/c", "orchestrator_mcp.bat"],
      "cwd": ".",
      "timeout_ms": 600000,
      "env": {
        "AGENT_MAX_STEPS": "10",
        "AGENT_MAX_TOKENS": "2048",
        "AGENT_TEMPERATURE": "0.2",
        "AGENT_HTTP_TIMEOUT": "600",
        "AGENT_MAX_DELEGATIONS": "8",
        "AGENT_PARALLELISM": "4"
      }
    }
  }
}
